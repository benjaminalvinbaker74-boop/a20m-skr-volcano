[mcu]
serial: /dev/ttyAMA0
restart_method: command

[virtual_sdcard]
path: ~/printer_data/gcodes
on_error_gcode: CANCEL_PRINT


[display_status]

[printer]
kinematics: cartesian
max_velocity: 100 #150 CAPPED FOR NOISE
max_accel: 3000
max_z_velocity: 20
max_z_accel: 100
minimum_cruise_ratio: 0.5  ###SET TO 0.5 AFTER TESTING
square_corner_velocity: 5 #3.5    ### DONT KNOW FIGURE YET TESTING


[stepper_x]
step_pin: P2.2
dir_pin: P2.6
enable_pin: !P2.1
microsteps: 16
#microsteps: 128
rotation_distance: 39.69 #39.892  ## was 40
#endstop_pin:!P1.26  #### using filament detectors bc tmc2209 keep pulling endstops high argh...
endstop_pin:^!P1.29  #### using originanl geetech endstops 3 pins led lights when switch activated  NOTE WIRES CROSS NOT STRAIGHT THROUGH
					####
					####		skr	pin 	________________________________					endstop pin
					####					|[S]				[LED]		]	
					####					|[w]      						]					
					####		5v			|[i]       				[p]		]  					5v (normally open)
                    ####		gnd			|[t]      				[l]		]					sensor (connected)
                    ####		sensor		|[c]					[u]		]					Gnd (normal connected)
                    ####					|[h]					[g]		]
                    ####					---------------------------------
position_endstop: -10
position_min: -10
position_max: 255
homing_speed: 20
#endstop_pin: tmc2209_stepper_x:virtual_endstop


[stepper_y]
step_pin: P0.19
dir_pin: !P0.20
enable_pin: !P2.8
microsteps: 16
#microsteps: 128
rotation_distance: 39.92
endstop_pin: ^!P1.28
#endstop_pin: !P1.25
position_endstop: 0
position_max: 255
homing_speed: 20

[stepper_z]
step_pin: P0.22
dir_pin: !P2.11
enable_pin: !P0.21
microsteps: 16
rotation_distance: 8
### change endstop to bltouch
#endstop_pin: !P1.27
#position_endstop: 0
position_min: -2
position_max: 250
endstop_pin: probe:z_virtual_endstop

# --- TUNED HOMING SPEEDS FOR BLTOUCH ---
homing_speed: 5.0            # Dropped from 10.0 to 4.0 mm/s for high-accuracy probing
homing_retract_dist: 4.0     # Distance to back away before the slow secondary tap
homing_retract_speed: 5.0    # Speed at which it lifts after the first touch
second_homing_speed: 2.0     # Ultra-slow second touch for perfect Z-height accuracy

### Include macros
#[include macros/set_pressure_advance.cfg]
[include mainsail.cfg]
[include macros/cancel.cfg]
[include macros/start_print.cfg]
[include macros/end_print.cfg]
[include macros/bltouch.cfg]
[include macros/pause_print.cfg]
[include macros/clean_nozzle.cfg]
[include macros/DISABLE_MOTORS.cfg]
[include macros/PARK_AND_SLEEP.cfg]
[include macros/WAKE_AND_RESUME.cfg]
[include macros/bed_heat_55.cfg]
[include macros/Raise_Z_Force_Move.cfg]

[force_move]
enable_force_move: True

[respond]
default_type: echo

[heater_bed]
heater_pin: P2.5
sensor_type: EPCOS 100K B57560G104F
sensor_pin: P0.25
control: pid
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

########################################
# TMC2209 configuration
########################################

[tmc2209 extruder]
uart_pin: EBB:PB3
#run_current: 0.650
stealthchop_threshold: 10
run_current: 0.45 #0.4
# #hold_current: 0.500
interpolate: True # False
sense_resistor: 0.110

[tmc2209 stepper_x]
uart_pin: P1.10
run_current: 0.650
#hold_current: 0.500
stealthchop_threshold: 999999
run_current: 0.65        # Adjust to 65% of your motor's real spec
interpolate: True # False
sense_resistor: 0.110

[tmc2209 stepper_y]
uart_pin: P1.9
run_current: 0.650
#hold_current: 0.500
stealthchop_threshold: 999999
interpolate: True # False
sense_resistor: 0.110

[tmc2209 stepper_z]
uart_pin: P1.8
run_current: 0.650
#hold_current: 0.450
stealthchop_threshold: 999999
interpolate: True #False
sense_resistor: 0.110


# --- BLTouch & Probing Zones --- STARRT ------- #
[bltouch]
sensor_pin: ^!EBB:PA5
control_pin: EBB:PA4
# sensor_pin: ^P0.10
# control_pin: P2.0
pin_move_time: 0.680
x_offset: -37
y_offset: 2
z_offset = 2.400
#z_offset: 2.335 #2.295 too close  # 2.165 going wrong way # 2.355 (baby steps after new head doesnt seem right is slicer error)
samples: 3 #  
samples_result: median
samples_tolerance: 0.05
samples_tolerance_retries: 3
sample_retract_dist: 4.0
pin_up_reports_not_triggered: False
probe_with_touch_mode: False
speed: 3.0              # This is the "fast" travel speed between points
lift_speed: 5         # Speed at which the probe lifts before moving
stow_on_each_sample: True
pin_up_touch_mode_reports_triggered: True
#   Set if the BLTouch consistently reports a "triggered" state after
#   the commands "pin_up" followed by "touch_mode". This should be
#   True for all genuine BLTouch devices. Read the directions in
#   docs/BLTouch.md before setting this to False. The default is True.
#set_output_mode:OD
#   Request a specific sensor pin output mode on the BLTouch V3.0 (and
#   later). This setting should not be used on other types of probes.
#   Set to "5V" to request a sensor pin output of 5 Volts (only use if
#   the controller board needs 5V mode and is 5V tolerant on its input
#   signal line). Set to "OD" to request the sensor pin output use
#   open drain mode. The default is to not request an output mode.
# [homing_override]
# axes: xyz
# gcode:
#   # 1. Force Klipper to believe Z is at 0 so it allows a lift
#   SET_KINEMATIC_POSITION Z=0
  
#   # 2. Lift Z by 10mm relative to its current position
#   G91                      # Relative positioning mode
#   G1 Z10 F600              # Raise Z 10mm at 10mm/s
#   G90                      # Back to Absolute positioning mode

#   # 3. Home X and Y axes
#   G28 X0
#   G28 Y0

#   # 4. Move to center of bed to safely home Z with BLTouch
#   G1 X82 Y44 F1800       # !!! CHANGE to your specific bed center coordinates
#   G28 Z0


[safe_z_home]
# left front corner screw
home_xy_position: 82, 44
speed: 30
z_hop: 4
z_hop_speed: 4

[bed_mesh]
speed: 30
horizontal_move_z: 5
# Safe limits for physical BLTouch Pin landing on PEI sheet away from clips
mesh_min: 25,25 #35, 35      moved bc clips messing up mesh
mesh_max: 195, 215   #218, 238 for near max, but clips and shit throw results way off so using smaller bed mesh
probe_count: 4, 4 ### set back to 7,7 just running diagnostics
mesh_pps: 2, 2
algorithm: bicubic
bicubic_tension: 0.2
move_check_distance: 5
split_delta_z: 0.05 # originally 0.025 but to finr for z axis adjustment 
#zero_reference_position: 87, 52
fade_start: 1.0
fade_end: 10.0
fade_target: 0

[bed_screws]
screw1: 92, 52
screw2: 92, 217
screw3: 213, 52
screw4: 213, 217

[screws_tilt_adjust]
# Nozzle positions adjusted so the probe pin lands exactly over bed screws
screw1: 82, 44
screw1_name: front left screw
screw2: 252, 44
screw2_name: front right screw
screw3: 252, 212
screw3_name: rear right screw
screw4: 82, 212
screw4_name: rear left screw
horizontal_move_z: 10.
speed: 50.
screw_thread: CW-M3

# --- BLTouch & Probing Zones --- END------- #


########################################
# EXP1 / EXP2 (display) pins
########################################

[board_pins]
aliases:
    # EXP1 header
    EXP1_1=P1.30, EXP1_3=P1.18, EXP1_5=P1.20, EXP1_7=P1.22, EXP1_9=<GND>,
    EXP1_2=P0.28, EXP1_4=P1.19, EXP1_6=P1.21, EXP1_8=P1.23, EXP1_10=<5V>,
    # EXP2 header
    EXP2_1=P0.17, EXP2_3=P3.26, EXP2_5=P3.25, EXP2_7=P1.31, EXP2_9=<GND>,
    EXP2_2=P0.15, EXP2_4=P0.16, EXP2_6=P0.18, EXP2_8=<RST>, EXP2_10=<NC>
    # Pins EXP2_1, EXP2_6, EXP2_2 are also MISO, MOSI, SCK of bus "ssp0"

# See the sample-lcd.cfg file for definitions of common LCD displays.

[exclude_object]

[input_shaper]
shaper_freq_x= 38.81    #### OFF FOR TESTING
shaper_freq_y= 60
shaper_type: 2hump_ei
####      x axis 3hump_ei @ 104.8 Hz


[pause_resume]

[display_status]

[endstop_phase]

[force_move]
enable_force_move: True

[respond]
default_type: echo
[include KAMP_Settings.cfg]

[include bigtreetech-ebb42-gen2.cfg]

[extruder]
step_pin: EBB:PD3
dir_pin: EBB:PD2
enable_pin: !EBB:PB6
microsteps: 16

rotation_distance:  21.740 # was over extruding 20.904 
gear_ratio: 50:17

#rotation_distance: 7.739 #7.754 # 7.725 #7.529 old calculated by gemini from Marlin 425.0
#rotation_distance: 33.500
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: EBB:PB0
sensor_type: EPCOS 100K B57560G104F
pullup_resistor: 2200
sensor_pin: EBB:PA1
control: pid
pid_Kp: 21.527
pid_Ki: 1.063
pid_Kd: 108.982
min_temp: 0
max_temp: 280
max_extrude_cross_section: 5.0
max_extrude_only_velocity: 45
max_extrude_only_accel: 1200     # <-- Add this to smooth out the acceleration ramp
pressure_advance: 0.6 # 0.44 #0.43    # <-- Type your winning number here 0.045  SET TO 0 FOR TESTING
pressure_advance_smooth_time: 0.06 # was 0.04 higher to smmoth out extruder noise
max_extrude_only_distance: 200.0
min_extrude_temp: 0
